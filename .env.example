# Nuxt runtime database connection
NUXT_DATABASE_URL=

# Better Auth
NUXT_BETTER_AUTH_SECRET=
NUXT_BETTER_AUTH_URL=

# Email delivery (Resend reference provider)
# Leave both empty to print emails in the local dev terminal. Both are required in production.
# Sender format: verified@example.com or App <verified@example.com>
NUXT_RESEND_API_KEY=
NUXT_EMAIL_FROM=

# Neon / Drizzle
# Neon pooled connection
DATABASE_URL=
# Neon direct connection for Drizzle tooling/migrations
DATABASE_URL_UNPOOLED=
NEON_BRANCH=
