{
  "name": "nuxt-auth-starter",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.3.4",
      "onFail": "warn"
    }
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "test": "vitest",
    "test:run": "vitest run",
    "auth:secret": "auth secret",
    "auth:generate": "auth generate --config ./server/auth/cli.ts --output ./server/database/schema/auth.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.9",
    "@lucide/vue": "^1.57.0",
    "@neondatabase/serverless": "^1.2.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@vercel/functions": "3.10.1",
    "@vueuse/core": "^14.4.0",
    "better-auth": "^1.7.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "1.0.0-rc.4",
    "nuxt": "^4.6.1",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.0",
    "vee-validate": "^5.0.0-beta.1",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vue-sonner": "^2.0.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@vue/test-utils": "^2.5.1",
    "auth": "^1.7.9",
    "dotenv": "^17.4.2",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "^10.12.0",
    "happy-dom": "^20.14.6",
    "neon": "^4.22.0",
    "shadcn-nuxt": "2.8.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.13"
  }
}
