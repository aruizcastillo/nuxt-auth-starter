{
  "name": "nuxt-auth-starter",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "test": "vitest",
    "test:run": "vitest run",
    "auth:generate": "pnpm dlx auth@1.7.3 generate --config ./server/auth/cli.ts --output ./server/database/schema/auth.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.3",
    "@lucide/vue": "^1.42.0",
    "@neondatabase/serverless": "^1.1.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@vueuse/core": "^14.4.0",
    "better-auth": "^1.7.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "1.0.0-rc.4",
    "nuxt": "^4.5.2",
    "reka-ui": "^2.10.4",
    "tailwind-merge": "^3.6.0",
    "vee-validate": "^5.0.0-beta.0",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1",
    "vue-sonner": "^2.0.9",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vue/test-utils": "^2.5.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "^10.10.0",
    "happy-dom": "^20.14.0",
    "neon": "^4.14.3",
    "shadcn-nuxt": "2.8.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  }
}
